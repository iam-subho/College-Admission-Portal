# ---------- All Markdown is private except the README ----------
*.md
!README.md

# ---------- Database schema is proprietary — email to obtain ----------
# Ship code architecture, NOT the schema. Anyone wanting to run this needs
# to request the migrations + seeders from the author (see README license).
/database/migrations/*.php
/database/seeders/*.php
/Modules/*/database/migrations/*.php
/Modules/*/database/seeders/*.php

# Keep the .gitkeep stubs so the directories themselves are preserved
!/database/migrations/.gitkeep
!/database/seeders/.gitkeep
!/Modules/*/database/migrations/.gitkeep
!/Modules/*/database/seeders/.gitkeep
